# ---------- Email notification (Gmail example) ----------
# 1) Google Account -> Security -> turn on 2-Step Verification
# 2) Google Account -> Security -> App passwords -> create one (16 letters)
# 3) Paste it below (spaces are fine, they are removed automatically)
NOTIFY_EMAIL=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SMTP_MAIL_FROM=you@gmail.com

# ---------- Spark (local mode inside the Airflow container) ----------
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g

# ---------- Airflow ----------
# Schedule is "0 2 * * *" (02:00 in this timezone). Example: Asia/Kolkata
AIRFLOW_TIMEZONE=UTC

# ---------- Monitoring & alerting (all optional - sensible defaults are built in) ----------
# Microsoft Teams: channel/chat -> Workflows -> "Post to a channel when a webhook request is received" -> paste URL
TEAMS_WEBHOOK_URL=
# Where alerts go: email,teams   (a channel without configuration is simply skipped)
ALERT_CHANNELS=email,teams
# INFO | WARNING | CRITICAL  (alerts below this are only logged/stored, not sent)
ALERT_MIN_SEVERITY=WARNING
GRAFANA_PASSWORD=admin
# Data-quality thresholds
MAX_QUARANTINE_PCT=5.0
MAX_NULL_PCT=1.0
ORPHAN_MAX_PCT=0
VOLUME_WARN_PCT=30
VOLUME_FAIL_PCT=60
DRIFT_Z_THRESHOLD=3
# 0 = off. Set e.g. 36 once real daily files arrive: warn when a source file is older than 36 hours
FRESHNESS_MAX_HOURS=0
PIPELINE_SLA_MINUTES=30
WATCHDOG_MAX_HOURS_SINCE_SUCCESS=30

# ---------- Source data straight from Kaggle (first task: download_source_files) ----------
# kaggle.com -> your profile picture -> Settings -> API -> create a token. NEVER commit or share these values.
DATA_SOURCE=kaggle
KAGGLE_DATASET=salikhussaini49/bank-dataset
KAGGLE_USERNAME=
KAGGLE_KEY=
# newer Kaggle accounts may give a single token instead of username+key - then fill this one:
KAGGLE_API_TOKEN=
# if the download fails but the 5 CSVs already exist in data/raw: continue (and send a WARNING) instead of failing
ALLOW_LOCAL_FALLBACK=true
