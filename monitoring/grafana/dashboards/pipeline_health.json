{
 "uid": "pipeline-health",
 "title": "Bank medallion pipeline - health, quality & alerts",
 "tags": [
  "pipeline",
  "monitoring"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-14d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Last run",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Last run status",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "obs-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "obs-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT status FROM obs.run_summary ORDER BY finished_at DESC LIMIT 1"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^(status|pass_rate|critical_failures|warnings)$/",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "SUCCESS": {
         "color": "green",
         "text": "SUCCESS"
        },
        "FAILED": {
         "color": "red",
         "text": "FAILED"
        }
       }
      }
     ],
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "DQ pass rate (last run)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "obs-pg"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "obs-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT round(100.0*checks_passed/NULLIF(checks_total,0),1) AS pass_rate FROM obs.run_summary ORDER BY finished_at DESC LIMIT 1"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^(status|pass_rate|critical_failures|warnings)$/",
